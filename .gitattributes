# Force LF line endings on text files that are executed or read in WSL2/Linux.
# Without this, autocrlf=true on Windows would inject CRLF and break shebangs
# in shell scripts and produce noisy diffs in C/Python sources.

*.sh        text eol=lf
*.c         text eol=lf
*.h         text eol=lf
*.py        text eol=lf
*.md        text eol=lf
*.csv       text eol=lf
Makefile    text eol=lf
.gitignore  text eol=lf
